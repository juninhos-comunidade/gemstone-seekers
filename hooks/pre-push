#!/bin/sh

CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
UPSTREAM=$(git rev-parse --abbrev-ref --symbolic-full-name "@{u}" 2>/dev/null || echo "")

# Fallback to default upstream branch if tracking is not configured
if [ -z "$UPSTREAM" ]; then
    UPSTREAM="origin/main"
fi

# Detect local changes relative to the remote tracking branch
API_CHANGED=$(git diff --name-only "$UPSTREAM"..HEAD 2>/dev/null | grep '^api/' || git diff --name-only HEAD~1..HEAD | grep '^api/' || true)
WEB_CHANGED=$(git diff --name-only "$UPSTREAM"..HEAD 2>/dev/null | grep '^web/' || git diff --name-only HEAD~1..HEAD | grep '^web/' || true)

# ==========================================
# BACK-END VALIDATION (api/)
# ==========================================
if [ -n "$API_CHANGED" ]; then
    echo "Running back-end quality gate (Checkstyle, PMD, SpotBugs)..."
    cd api || exit 1

    # Run full static code analysis suite
    if ! ./mvnw checkstyle:check pmd:check spotbugs:check -Dskip.git.hooks=true --no-transfer-progress -q; then
        echo "ERROR: Back-end quality gate failed. Push aborted."
        exit 1
    fi

    # Execute complete back-end automated test suite
    echo "Running all back-end unit and integration tests..."
    if ! ./mvnw test -Dskip.git.hooks=true --no-transfer-progress -q; then
        echo "ERROR: Back-end test suite failed. Push aborted."
        exit 1
    fi

    cd ..
fi

# ==========================================
# FRONT-END VALIDATION (web/)
# ==========================================
if [ -n "$WEB_CHANGED" ]; then
    echo "Running front-end tests and coverage validation..."
    cd web || exit 1

    # Run front-end unit tests with coverage reporting
    if ! pnpm exec vitest run --coverage; then
        echo "ERROR: Front-end tests or coverage failed. Push aborted."
        exit 1
    fi

    cd ..
fi

echo "All quality gates and test suites passed successfully. Pushing."
exit 0
